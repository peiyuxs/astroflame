{
	"name": "astroflame",
	"version": "0.1.0",
	"private": true,
	"packageManager": "npm",
	"dependencies": {
		"@vinext/cloudflare": "latest",
		"csv-parse": "^7.0.3",
		"dotenv": "^18.0.10",
		"pg": "^8.23.1",
		"react": "latest",
		"react-dom": "latest",
		"react-server-dom-webpack": "latest",
		"vinext": "latest"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "beta",
		"@tailwindcss/postcss": "latest",
		"@types/node": "latest",
		"@types/pg": "^8.23.1",
		"@types/react": "latest",
		"@types/react-dom": "latest",
		"@vitejs/plugin-react": "latest",
		"@vitejs/plugin-rsc": "latest",
		"cf": "^1.0.0-beta.32",
		"tailwindcss": "latest",
		"typescript": "latest",
		"vite": "8.3.0"
	},
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "vite preview",
		"deploy": "vinext-cloudflare deploy",
		"preview": "npm run build && npm run start --",
		"cf-typegen": "cf workers types",
		"db:migrate": "node scripts/migrate-db.mjs",
		"data:preview": "node scripts/import-nasa-data.mjs --dry-run",
		"data:import": "node scripts/import-nasa-data.mjs",
		"test:import": "node --test scripts/import-nasa-data.test.mjs",
		"test:model": "node --experimental-strip-types --test lib/bass-model.test.mjs lib/flame-simulation.test.mjs"
	}
}